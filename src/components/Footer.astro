---
import { site } from "../data/site";
const year = new Date().getFullYear();
---

<footer class="mt-24 border-t border-line-strong">
  <div
    class="mx-auto flex max-w-6xl flex-col gap-4 px-5 py-8 sm:flex-row sm:items-center sm:justify-between sm:px-8"
  >
    <p class="text-sm text-forest-soft">
      <span class="font-semibold text-forest">{site.name}</span>
      <span class="mx-2 text-line-strong">/</span>
      <span class="tnum">{year}</span>
    </p>

    <ul class="flex items-center gap-1">
      <li>
        <a
          href={site.linkedin}
          rel="me noopener noreferrer"
          target="_blank"
          aria-label="LinkedIn profile"
          title="LinkedIn"
          class="flex h-10 w-10 items-center justify-center rounded-md border border-line text-forest transition-colors hover:border-emerald-deep hover:text-emerald-deep"
        >
          <svg viewBox="0 0 24 24" class="h-[18px] w-[18px]" fill="currentColor" aria-hidden="true">
            <path
              d="M4.98 3.5a2.5 2.5 0 1 1 0 5 2.5 2.5 0 0 1 0-5ZM3 9h4v12H3V9Zm7 0h3.8v1.7h.06c.53-.95 1.83-1.95 3.77-1.95C21.4 8.75 22 11.1 22 14.16V21h-4v-6.06c0-1.45-.03-3.3-2.03-3.3-2.03 0-2.34 1.57-2.34 3.2V21h-4V9Z"
            ></path>
          </svg>
        </a>
      </li>
      <li>
        <a
          href={site.scholar}
          rel="me noopener noreferrer"
          target="_blank"
          aria-label="Google Scholar profile"
          title="Google Scholar"
          class="flex h-10 w-10 items-center justify-center rounded-md border border-line text-forest transition-colors hover:border-emerald-deep hover:text-emerald-deep"
        >
          <svg viewBox="0 0 24 24" class="h-[18px] w-[18px]" fill="currentColor" aria-hidden="true">
            <path d="M12 2 0 8.4l4.2 2.24V16c0 .1.02.2.06.29C5.36 18.5 8.47 20 12 20s6.64-1.5 7.94-3.71c.04-.1.06-.19.06-.29v-5.36L22 9.55V16h2V8.4L12 2Zm0 4.42 7.2 3.84L12 14.1 4.8 10.26 12 6.42ZM6.2 11.71 12 14.8l5.8-3.09v3.85C16.66 17.14 14.5 18 12 18s-4.66-.86-5.8-2.44v-3.85Z"></path>
          </svg>
        </a>
      </li>
      <li>
        <a
          href={`mailto:${site.email}`}
          aria-label={`Email ${site.name}`}
          title="Email"
          class="flex h-10 w-10 items-center justify-center rounded-md border border-line text-forest transition-colors hover:border-emerald-deep hover:text-emerald-deep"
        >
          <svg viewBox="0 0 24 24" class="h-[18px] w-[18px]" fill="currentColor" aria-hidden="true">
            <path
              d="M2 5.5A1.5 1.5 0 0 1 3.5 4h17A1.5 1.5 0 0 1 22 5.5v13a1.5 1.5 0 0 1-1.5 1.5h-17A1.5 1.5 0 0 1 2 18.5v-13ZM4 7.06V18h16V7.06l-8 5.1-8-5.1ZM19.3 6H4.7l7.3 4.66L19.3 6Z"
            ></path>
          </svg>
        </a>
      </li>
    </ul>
  </div>
</footer>
