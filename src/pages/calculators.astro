---
import Base from "../layouts/Base.astro";
import { calculators } from "../data/calculators";
---

<Base
  title="Calculators"
  description="Engineering calculators by Tilak Bhusal for HVAC, energy efficiency, and practical engineering analysis."
>
  <div class="mx-auto max-w-6xl px-5 pt-10 sm:px-8 sm:pt-16">
    <p class="text-sm font-semibold tracking-widest text-emerald-deep">ENGINEERING TOOLS</p>
    <h1 class="mt-4 text-display font-extrabold">Calculators</h1>
    <p class="mt-5 max-w-[62ch] text-lg leading-relaxed text-forest/90">
      Practical tools for understanding energy and building systems. Choose a calculator
      to explore the numbers, check assumptions, and see how the equations work.
    </p>
  </div>

  <section aria-label="Available calculators" class="mx-auto mt-12 max-w-6xl px-5 pb-8 sm:px-8">
    <ul class="grid gap-5 md:grid-cols-2">
      {calculators.map((calculator) => (
        <li class="flex">
          <a href={calculator.href} class="calculator-card panel flex w-full flex-col rounded-xl px-6 py-7 transition-colors hover:border-emerald-deep/60">
            <p class="text-sm font-semibold text-emerald-deep">{calculator.category}</p>
            <h2 class="mt-3 text-h3 font-bold">{calculator.title}</h2>
            <p class="mt-3 leading-relaxed text-forest/90">{calculator.description}</p>
            <ul aria-label="Features" class="mt-5 flex flex-wrap gap-2">
              {calculator.features.map((feature) => (
                <li class="rounded-full border border-line-strong px-3 py-1 text-xs text-forest-soft">{feature}</li>
              ))}
            </ul>
            <span class="mt-7 flex items-center justify-between border-t border-line pt-4 font-semibold text-emerald-deep">
              Open calculator <span aria-hidden="true">↗</span>
            </span>
          </a>
        </li>
      ))}
    </ul>
  </section>
</Base>

<style>
  .calculator-card:focus-visible {
    outline: 3px solid var(--color-emerald-deep);
    outline-offset: 4px;
  }
</style>
