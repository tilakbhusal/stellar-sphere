---
import Base from "../layouts/Base.astro";
import { site } from "../data/site";
---

<Base
  title="Contact"
  description={`Get in touch with Tilak Bhusal — ${site.email}`}
>
  <div class="panel px-6 py-7 sm:px-8 sm:py-9">
  <h2 class="text-h3 font-semibold">Email</h2>
  <a
    href={`mailto:${site.email}`}
    class="mt-2 block text-xl font-bold break-all text-emerald-deep link-underline sm:text-2xl"
  >
    {site.email}
  </a>

  <div class="mt-7 flex flex-wrap items-center gap-3">
    <a
      href={`mailto:${site.email}`}
      class="rounded-md bg-emerald px-5 py-3 text-[0.95rem] font-semibold text-deep transition-colors hover:bg-emerald-deep hover:text-mist"
    >
      Send an email
    </a>
  </div>

  <!RESUME PREVIEW>
  <h2 class="text-h3 font-semibold mt-10">Resume Preview</h2>
  <p class="mt-3 text-forest-soft text-[0.95rem] leading-relaxed">
    My resume summarizes my work in industrial energy efficiency, utility program engineering,
    and quantitative analysis. It includes my professional experience, technical skills,
    certifications, and selected projects.
  </p>

  <ul class="mt-4 space-y-2 text-sm text-forest-soft">
    <li>• Industrial & commercial energy audits (ASHRAE I–II)</li>
    <li>• Measurement-based savings verification</li>
    <li>• Utility program engineering & decarbonization work</li>
    <li>• CEM, LEED GA, EIT credentials</li>
  </ul>

  <div class="mt-7 flex flex-wrap items-center gap-3">
    <a
      href={site.resume}
      download="Tilak-Bhusal-Resume.pdf"
      class="rounded-md border border-line-strong px-5 py-3 text-[0.95rem] font-semibold transition-colors hover:border-emerald-deep hover:text-emerald-deep"
    >
      Download resume
    </a>
  </div>

  <p class="mt-5 text-sm text-forest-soft">
    Prefer the long version? <a href={site.cv} download class="link-underline font-medium"
      >Download the full CV</a
    >.
  </p>
</div>

      <aside class="panel px-6 py-7">
        <h2 class="text-h3 font-semibold">Elsewhere</h2>
        <ul class="mt-4 space-y-4">
          <li>
            <a
              href={site.linkedin}
              target="_blank"
              rel="noopener noreferrer"
              class="font-semibold link-underline">LinkedIn</a
            >
            <p class="mt-0.5 text-sm text-forest-soft">Roles, updates, and professional network.</p>
          </li>
          <li>
            <a
              href={site.scholar}
              target="_blank"
              rel="noopener noreferrer"
              class="font-semibold link-underline">Google Scholar</a
            >
            <p class="mt-0.5 text-sm text-forest-soft">Publications and citations.</p>
          </li>
        </ul>

        <div class="mt-7 border-t border-line pt-5">
          <h3 class="text-sm font-semibold">Location</h3>
          <p class="mt-1 text-forest-soft">{site.location}</p>
        </div>
      </aside>
    </div>
  </section>
</Base>
