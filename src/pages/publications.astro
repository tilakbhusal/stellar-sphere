---
import Base from "../layouts/Base.astro";
import SectionHeading from "../components/SectionHeading.astro";
import PublicationEntry from "../components/PublicationEntry.astro";
import { peerReviewed, presentations, conferences } from "../data/publications";
import { site } from "../data/site";

const byYear = <T extends { year: string }>(a: T, b: T) => Number(b.year) - Number(a.year);
const papers = [...peerReviewed].sort(byYear);
const talks = [...presentations].sort(byYear);
---

<Base
  title="Publications"
  description="Peer-reviewed publications, work in progress, and conference presentations by Tilak Bhusal on energy consumption, energy equity, and efficiency."
>
  <div class="mx-auto max-w-6xl px-5 pt-10 sm:px-8 sm:pt-16">
    <h1 class="text-display font-extrabold">Publications</h1>
    <p class="mt-5 max-w-[62ch] text-lg leading-relaxed text-forest/90">
      Research on what actually drives energy consumption — and who bears the cost of it.
    </p>
    <p class="mt-5 text-sm">
      <a
        href={site.scholar}
        target="_blank"
        rel="noopener noreferrer"
        class="font-medium text-emerald-deep link-underline">Google Scholar profile</a
      >
    </p>
  </div>

  <section class="mx-auto mt-16 max-w-6xl px-5 sm:mt-20 sm:px-8">
    <SectionHeading title="Peer-reviewed" as="h2" aside="Reverse chronological. APA style." />
    <ol class="mt-4 divide-y divide-line">
      {papers.map((p, i) => <PublicationEntry item={p} index={i + 1} />)}
    </ol>
  </section>

  <section class="mx-auto mt-16 max-w-6xl px-5 sm:mt-20 sm:px-8">
    <SectionHeading title="Work in progress" as="h2" />
    <ol class="mt-4 divide-y divide-line">
      {inProgress.map((p, i) => <PublicationEntry item={p} index={i + 1} />)}
    </ol>
  </section>

  <section class="mx-auto mt-16 max-w-6xl px-5 sm:mt-20 sm:px-8">
    <SectionHeading title="Conference presentations" as="h2" />
    <ol class="mt-4 divide-y divide-line">
      {talks.map((p, i) => <PublicationEntry item={p} index={i + 1} />)}
    </ol>
  </section>

  <section class="mx-auto mt-16 max-w-6xl px-5 sm:mt-20 sm:px-8">
    <SectionHeading title="Conferences attended" as="h2" />
    <ol class="mt-4 divide-y divide-line">
      {
        conferences.map((c) => (
          <li class="grid gap-x-10 gap-y-1 py-3.5 sm:grid-cols-[5rem_minmax(0,1fr)]">
            <p class="text-sm font-semibold tnum text-forest-soft">{c.year}</p>
            <p class="max-w-[70ch]">{c.name}</p>
          </li>
        ))
      }
    </ol>
  </section>
</Base>
