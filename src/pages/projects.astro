---
import Base from "../layouts/Base.astro";
import { projects } from "../data/projects";

const sorted = [...projects].sort((a, b) => Number(b.year) - Number(a.year));
---

<Base
  title="Projects"
  description="Energy analytics, feasibility studies, and engineering projects by Tilak Bhusal."
>
  <div class="mx-auto max-w-6xl px-5 pt-10 sm:px-8 sm:pt-16">
    <h1 class="text-display font-extrabold">Projects</h1>
    <p class="mt-5 max-w-[62ch] text-lg leading-relaxed text-forest/90">
      Energy analytics, feasibility studies, and hardware. Each entry is scoped by what was
      measured and what the numbers supported.
    </p>
  </div>

  <section class="mx-auto mt-14 max-w-6xl px-5 sm:px-8">
    <ul class="grid gap-4 md:grid-cols-2">
      {
        sorted.map((p) => (
          <li
            id={p.slug}
            class="panel flex scroll-mt-24 flex-col px-6 py-6 transition-colors hover:border-emerald-deep/60"
          >
            <div class="flex items-baseline justify-between gap-4">
              <p class="text-sm font-semibold text-emerald-deep">{p.kind}</p>
              <p class="text-sm tnum text-forest-soft">{p.year}</p>
            </div>

            <h2 class="mt-2.5 text-h3 font-bold text-balance">{p.title}</h2>
            <p class="mt-2.5 leading-relaxed text-forest/90">{p.summary}</p>

            {p.points && (
              <ul class="mt-3.5 space-y-2">
                {p.points.map((pt) => (
                  <li class="relative pl-5 text-[0.95rem] leading-relaxed">
                    <span
                      aria-hidden="true"
                      class="absolute top-[0.62em] left-0 h-1.5 w-1.5 rounded-[1px] bg-emerald"
                    />
                    {pt}
                  </li>
                ))}
              </ul>
            )}

            {p.metrics && (
              <dl class="mt-4 flex flex-wrap gap-x-8 gap-y-2 border-t border-line pt-3.5">
                {p.metrics.map((m) => (
                  <div>
                    <dt class="text-xs text-forest-soft">{m.label}</dt>
                    <dd class="text-lg font-bold tnum">{m.value}</dd>
                  </div>
                ))}
              </dl>
            )}

            {/*
              Case-study slot. Drop a chart in here when a project graduates:
              <EnergyChart client:visible type="bar" data={...} />
            */}

            <div class="mt-auto pt-6">
              <div class="flex flex-wrap items-center gap-x-3 gap-y-2 border-t border-line pt-4">
                {p.stack.map((s) => (
                  <span class="text-sm text-forest-soft">{s}</span>
                ))}
              </div>

              {p.funder && (
                <p class="mt-3 text-sm text-forest-soft">
                  Funded by <span class="font-medium text-forest">{p.funder}</span>
                </p>
              )}
            </div>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="mx-auto mt-16 max-w-6xl px-5 sm:px-8">
    <p class="max-w-[60ch] text-forest-soft">
      Longer write-ups with charts and full method live in the
      <a href="/articles" class="link-underline font-medium text-emerald-deep">articles</a>.
    </p>
  </section>
</Base>
